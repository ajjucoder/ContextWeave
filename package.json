{
  "name": "contextweave",
  "version": "0.1.0",
  "description": "Local-first MCP server for AST-aware context capsules with cross-session memory",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cw": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx bench/harness.ts",
    "bench:concurrent": "tsx bench/concurrent-stress.ts",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "context",
    "ast",
    "tree-sitter",
    "claude"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@parcel/watcher": "^2.5.6",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "gpt-tokenizer": "3.4.0",
    "tree-sitter": "0.21.1",
    "tree-sitter-bash": "0.23.3",
    "tree-sitter-c": "0.23.2",
    "tree-sitter-c-sharp": "0.23.1",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.23.4",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-php": "0.23.11",
    "tree-sitter-python": "0.23.4",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.23.1",
    "tree-sitter-typescript": "0.23.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "@types/parcel__watcher": "^2.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
